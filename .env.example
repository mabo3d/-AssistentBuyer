# AssistentBuyer – Lokale Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an

# =====================================================================
# MP12N / Hänel-Integration
# =====================================================================

# MP12N-Basis-URL (ohne Slash am Ende)
# Beispiel: http://192.168.1.100 oder http://mp12n.local
MP12N_BASE_URL=http://MP12N-IP

# MP12N-Verbindungs-Timeout in Sekunden
MP12N_TIMEOUT=6

# MP12N-Cache-Dauer in Sekunden (für Bestellvorschläge)
MP12N_CACHE_SECONDS=5

# =====================================================================
# Datenbank & Daten
# =====================================================================

# Pfad zum Datenverzeichnis (lokal oder portabel)
# Leer = automatisch (portable neben EXE oder in %LOCALAPPDATA%)
ASSISTENTBUYER_DATA_DIR=

# =====================================================================
# SharePoint / Zentrale Daten (für später)
# =====================================================================

# SharePoint Tenant/Site
SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_ID=

# SharePoint Lists
SHAREPOINT_LIST_MATERIALS=
SHAREPOINT_LIST_ORDERS=

# =====================================================================
# Anwendung
# =====================================================================

# Standard-Bereich beim Start (H=Hydraulik, E=Elektrik)
DEFAULT_AREA=H

# Log-Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=WARNING

# =====================================================================
# WICHTIG: Niemals in .env speichern:
# =====================================================================
# - MP12N-Session-Cookies
# - MP12N-Login-Daten
# - SharePoint-Client-Secrets
# - API-Keys oder Tokens
# =====================================================================
